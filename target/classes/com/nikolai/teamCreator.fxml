<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>

<VBox spacing="10"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nikolai.TeamCreatorController"
      style="-fx-padding: 20;">

    <Button text="Back" onAction="#goBack"/>
    <Label text="Team Editor"/>

    <VBox spacing="10">
        <TextField fx:id="pokemonField" promptText="Enter pokemon name or id"/>
        <TextField fx:id="itemField" promptText="Enter held item"/>
        <TextField fx:id="moveField1" promptText="Enter move name"/>
        <TextField fx:id="moveField2" promptText="Enter move name"/>
        <TextField fx:id="moveField3" promptText="Enter move name"/>
        <TextField fx:id="moveField4" promptText="Enter move name"/>

        <Button text="Add Pokemon" onAction="#onAddPokemon"/>
        
    </VBox>

    <Label fx:id="teamLabel" text="Team: "/>

    <TextField fx:id="teamNameField" promptText="Enter team name"/>

    <Button text="Save Team" onAction="#onSaveTeam"/>

</VBox>
