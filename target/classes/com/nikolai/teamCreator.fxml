<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>

<VBox spacing="10"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nikolai.TeamCreatorController"
      style="-fx-padding: 20;">

    <Button text="Back" onAction="#goBack"/>
    <Label text="Team Editor"/>

    <Label fx:id="teamLabel" text="Team: "/>

    <TextField fx:id="teamNameField" promptText="Enter team name"/>

    <HBox spacing="10">
        <TextField fx:id="pokemonField" promptText="Enter pokemon name or id"/>
        <VBox spacing="5">
            <Label text="Held Item"/>
            <TextField fx:id="itemField" promptText="Enter held item"/>

            <Label text="Ability"/>
            <ComboBox fx:id="abilityDropdown" promptText="Select ability"/>

            <Label text="Nature"/>
            <ComboBox fx:id="natureDropdown" promptText="Select nature"/>
        </VBox>
        <VBox spacing="5">
            <Label text="Moves"/>
            <ComboBox fx:id="moveDropdown1" promptText="Select move"/>
            <ComboBox fx:id="moveDropdown2" promptText="Select move"/>
            <ComboBox fx:id="moveDropdown3" promptText="Select move"/>
            <ComboBox fx:id="moveDropdown4" promptText="Select move"/>
        </VBox>

        <Button text="Load Pokemon" onAction="#onLoadPokemon"/>
        <Button text="Add Pokemon" onAction="#onAddPokemon"/>
    </HBox>

    <Button text="Save Team" onAction="#onSaveTeam"/>

</VBox>